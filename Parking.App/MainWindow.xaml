<ui:FluentWindow x:Class="Parking.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Parking.App"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:components="clr-namespace:Parking.App.Views.Components" 
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource IranYekanFont}"  
        FlowDirection="RightToLeft"
        Title="MainWindow" Height="768" Width="1024"
        Closing="Window_Closing"
                  >
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:NavigationView
        x:Name="RootNavigation"
        Grid.Row="1"
        Padding="3"
        Margin="2"
        FooterMenuItemsSource="{Binding ViewModel.FooterMenuItems, Mode=OneWay}"
        FrameMargin="5"
        IsBackButtonVisible="Visible"
        IsPaneToggleVisible="True" 
        MenuItemsSource="{Binding ViewModel.MenuItems, Mode=OneWay}"
        PaneDisplayMode="LeftFluent"
        ItemInvoked="RootNavigation_OnItemInvoked">
                <ui:NavigationView.ContentOverlay>
                    <Grid>
                        <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                    </Grid>
                </ui:NavigationView.ContentOverlay>
            </ui:NavigationView>

            <ContentPresenter
        x:Name="RootContentDialog"
        Grid.Row="0"
        Grid.RowSpan="2" />

            <ui:TitleBar
        x:Name="TitleBar"
        Title="{Binding ViewModel.ApplicationTitle}"
        Grid.Row="0"
        CloseWindowByDoubleClickOnIcon="True">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui-icon-256.png" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>
        </Grid>
        <components:TrayIconView x:Name="myNotifyTray"/>
    </Grid>

</ui:FluentWindow>
