<Window x:Class="Parking.App.Views.Windows.TempLoginWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Parking.App.Views.Windows"
        mc:Ignorable="d"
        Title="TempLoginWindows" Height="200" Width="200">
    <Grid>

        <StackPanel Margin="20">
            <TextBlock Text="Username"/>
            <TextBox x:Name="txtUsername" Margin="0,5,0,10"/>

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="txtPassword" Margin="0,5,0,10"/>

            <Button Content="Login" Width="100" HorizontalAlignment="Right" Click="BtnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
