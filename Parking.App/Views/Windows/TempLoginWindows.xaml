<Window x:Class="Parking.App.Views.Windows.TempLoginWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Parking.App.Views.Windows"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Height="300"
        Width="350"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid FlowDirection="RightToLeft">
        <StackPanel Margin="20" HorizontalAlignment="Center">

            <StackPanel Width="260" Margin="5">
                <TextBlock Text="نام کاربری"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:TextBox x:Name="usernameBox"
                            TextChanged="usernameBox_TextChanged"
                            FlowDirection="LeftToRight"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"/>
            </StackPanel>

            <StackPanel Width="260" Margin="5">
                <TextBlock Text="رمز عبور"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ui:PasswordBox x:Name="passwordBox"
                                TextChanged="passwordBox_TextChanged"
                                FlowDirection="LeftToRight"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"/>
            </StackPanel>

            <Button Content="ورود"
                    Width="100"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Click="BtnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
