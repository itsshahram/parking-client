<ui:FluentWindow x:Class="Parking.App.Views.Windows.AssignRoleWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="{StaticResource IranYekanFont}"  
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Title="تخصیص نقش به کاربر"
                 FlowDirection="RightToLeft"
                 WindowStartupLocation="CenterOwner"
                 Height="500" Width="450">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Role selection -->
        <ComboBox Grid.Row="0"
                  ItemsSource="{Binding Roles}"
                  SelectedItem="{Binding SelectedRole}"
                  DisplayMemberPath="FaName"
                  Margin="0 0 0 10"/>

        <!-- Permissions list -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Permissions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding FaName}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  IsEnabled="{Binding IsEnabled}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
            <ui:Button Content="ذخیره" Width="100" Margin="5 0" Click="SaveButton_Click"/>
            <ui:Button Content="انصراف" Width="100" Margin="5 0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
