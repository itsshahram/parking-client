<ui:FluentWindow x:Class="Parking.App.Views.Windows.CustomAmountPaymentModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource IranYekanFont}"  
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FlowDirection="RightToLeft"
        Title="پرداخت مبلغ دلخواه"
        d:DesignWidth="350"
        Width="350"
        Height="250">

    <StackPanel Margin="10" VerticalAlignment="Center" HorizontalAlignment="Stretch">

        <!-- مبلغ input -->
        <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
            <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:TextBox x:Name="AmountTextBox"
                                    MinWidth="200"
                                    FlowDirection="LeftToRight"
                                    VerticalAlignment="Center"
                                    Text="0"
                                    PlaceholderText="0"
                                    TextChanged="AmountTextBox_TextChanged"/>
                        <TextBlock DockPanel.Dock="Left" Margin="5" Text="ریال" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Margin="5" Text="مبلغ" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Buttons (Confirm + Close in one row) -->
        <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:Button x:Name="ConfirmButton"
                           Content="تأیید"
                           Appearance="Primary"
                           Width="120"
                           Height="35"
                           Click="ConfirmButton_Click"/>

                <ui:Button x:Name="CloseButton"
                           Content="بستن"
                           Appearance="Secondary"
                           Width="120"
                           Height="35"
                           Click="CloseButton_Click"/>
            </StackPanel>
        </Border>

    </StackPanel>
</ui:FluentWindow>
