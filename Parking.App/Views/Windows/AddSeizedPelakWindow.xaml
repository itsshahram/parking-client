<ui:FluentWindow x:Class="Parking.App.Views.Windows.AddSeizedPelakWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Parking.App.Views.Windows"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="{StaticResource IranYekanFont}"  
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Title="افزودن توقیفی"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" Height="300" Width="420">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Plate input -->
            <RowDefinition Height="*"/>
            <!-- Description -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="پلاک خودرو" 
                   FontSize="16" 
                   FontWeight="SemiBold" 
                   Margin="0 0 0 10"/>

        <!-- Plate Input -->
        <StackPanel Grid.Row="1" Margin="0 15 0 10" HorizontalAlignment="Stretch">
            <!-- Toggle Switch -->
            <ui:ToggleSwitch x:Name="SinglePlateToggle" 
                 OnContent="پلاک خارجی"
                 OffContent="پلاک داخلی"
                 Checked="SinglePlateToggle_Checked"
                 Unchecked="SinglePlateToggle_Unchecked"
                 HorizontalAlignment="Left"
                 Margin="0 0 0 10"/>

            <!-- Single foreign plate input -->
            <ui:TextBox x:Name="FullPlateTextBox"
                        Visibility="Collapsed"
                        PlaceholderText="پلاک خارجی"
                        FontSize="20"
                        FontWeight="Bold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        Margin="0 5 0 0"/>

            <!-- Segmented plate input -->
            <Grid x:Name="SegmentedPlateGrid" HorizontalAlignment="Stretch" FlowDirection="LeftToRight" Margin="0 5 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" x:Name="leftNumbersNumberTextBox" FontSize="20" FontWeight="Bold"
                    PlaceholderText="_ _" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}"/>

                <ComboBox Grid.Column="1" x:Name="plateCharsCombo" IsEditable="True" FontSize="20"
                  SelectedIndex="0" Margin="1 0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  Background="{DynamicResource ControlFillColorDefaultBrush}"/>

                <ui:TextBox Grid.Column="2" x:Name="rightNumbersNumberTextBox" FontSize="20" FontWeight="Bold"
                    PlaceholderText="_ _ _" Margin="1 0" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"/>

                <ui:TextBox Grid.Column="3" x:Name="irNumberTextBox" FontSize="20" FontWeight="Bold"
                    MaxLength="2" Margin="1 0" HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"/>
            </Grid>
        </StackPanel>

        <!-- Description -->
        <StackPanel Grid.Row="2" Margin="0 15 0 0">
            <TextBlock Text="توضیحات" FontSize="14" Margin="0 0 0 5"/>
            <ui:TextBox x:Name="DescriptionTextBox"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        PlaceholderText="علت توقیف یا توضیحات بیشتر..."
                        VerticalContentAlignment="Top"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 15 0 0">
            <ui:Button Click="Save_Click" Content="ثبت" Width="100" Height="32"
                       Appearance="Primary" Margin="5 0"/>
            <ui:Button Click="Close_Click" Content="انصراف" Width="100" Height="32"
                       Appearance="Secondary" Margin="5 0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
