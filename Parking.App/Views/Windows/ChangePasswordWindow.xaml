<ui:FluentWindow x:Class="Parking.App.Views.Windows.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Parking.App.Views.Windows"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource IranYekanFont}"  
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Title="عوض کردن رمز عبور" Height="550" Width="400" FlowDirection="RightToLeft">
    <StackPanel VerticalAlignment="Center" Margin="15">
        <!--<ui:TitleBar
        x:Name="TitleBar" DockPanel.Dock="Top"
        Title="عوض کردن رمز عبور کاربر"
        Grid.Row="0"
        CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui-icon-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>-->
        <StackPanel HorizontalAlignment="Center">
            <ui:Image Source="pack://application:,,,/Assets/profile.png" Width="100"/>
            <Separator Margin="0 5"/>
            <TextBlock Text="تعویض رمز عبور"  FontSize="20" FontWeight="Bold"/>
            <Separator Margin="0 5"/>
            <TextBlock Text="{Binding UserName, Mode=OneWay}" x:Name="UserName" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding UserFullName, Mode=OneWay}" x:Name="UserFullname" HorizontalAlignment="Center"/>

        </StackPanel>
        <StackPanel >
            <!--<StackPanel  Margin="5">
                <TextBlock Text="رمز عبور قبلی"     />
                <ui:PasswordBox x:Name="OldPasswordTextBox" TextChanged="PasswordTextBox_TextChanged" Password="{Binding OldPassword, Mode=TwoWay}" FlowDirection="LeftToRight"/>
            </StackPanel>-->
            <StackPanel  Margin="5">
                <TextBlock Text="رمز عبور"     />
                <ui:PasswordBox x:Name="PasswordTextBox" TextChanged="PasswordTextBox_TextChanged" Password="{Binding NewPassword, Mode=TwoWay}" FlowDirection="LeftToRight"/>
            </StackPanel>
            <StackPanel  Margin="5">
                <TextBlock Text="تکرار رمز عبور" />
                <ui:PasswordBox x:Name="ConfirmPasswordTextBox" TextChanged="PasswordTextBox_TextChanged" Password="{Binding ConfirmPassword, Mode=TwoWay}" FlowDirection="LeftToRight"/>
            </StackPanel>
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ui:Button   Grid.Column="1" 
                                           x:Name="SavePasswordBtn"
                                           IsEnabled="False" 
                                           Icon="{ui:SymbolIcon Symbol=AppFolder24}" 
                                           Content="ورود" 
                                           Height="40" 
                                           Margin="10 0"
                             Click="SavePasswordBtn_Click"
                               Appearance="Success"
                                           HorizontalAlignment="Stretch"/>
                <ui:Button Appearance="Transparent"  Grid.Column="0"
                               x:Name="ExitBtn"
                           Click="ExitBtn_Click"
                           Icon="{ui:SymbolIcon Symbol=ArrowExit20}" 
                           Content="انصراف" 
                           Height="40"
                           Margin="10 0" HorizontalAlignment="Stretch"
                           />
            </Grid>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
