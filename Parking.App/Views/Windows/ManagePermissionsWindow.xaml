<ui:FluentWindow x:Class="Parking.App.Views.Windows.ManagePermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="{StaticResource IranYekanFont}"  
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Title="مدیریت دسترسی‌ها"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        Height="400" Width="450">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="مدیریت دسترسی‌ها" 
                   FontWeight="Bold" FontSize="16" 
                   Margin="0 0 0 20"/>

        <!-- Permissions List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Select All -->
                <CheckBox Content="انتخاب همه"
                          IsChecked="{Binding AreAllPermissionsSelected, Mode=TwoWay}"/>

                <!-- Individual permissions -->
                <ItemsControl ItemsSource="{Binding Permissions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding FaName}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center"  Margin="0 20 0 0">
            <ui:Button Content="ذخیره" Width="100" Click="SaveButton_Click"/>
            <ui:Button Content="انصراف" Width="100" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
