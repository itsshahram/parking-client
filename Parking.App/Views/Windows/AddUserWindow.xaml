<ui:FluentWindow x:Class="Parking.App.Views.Windows.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Parking.App.Views.Windows"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="{StaticResource IranYekanFont}"  
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Title="افزودن کاربر"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner" Height="550" Width="400">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="289*"/>
            <ColumnDefinition Width="71*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="افزودن کاربر جدید" 
                   FontWeight="Bold" FontSize="16" 
                   HorizontalAlignment="Left" Margin="121,0,0,20"/>

        <!-- Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top" Grid.ColumnSpan="2">

            <!-- First Name -->
            <StackPanel Margin="0 0 0 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="نام:" Width="100" VerticalAlignment="Center"/>
                    <ui:TextBox Width="300"
                        Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, 
                                       ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                </StackPanel>
                <TextBlock Foreground="Red" FontSize="12" 
                           Text="{Binding (Validation.Errors)[0].ErrorContent, 
                                  RelativeSource={RelativeSource Mode=PreviousData}}"/>
            </StackPanel>

            <!-- Last Name -->
            <StackPanel Margin="0 0 0 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="نام خانوادگی:" Width="100" VerticalAlignment="Center"/>
                    <ui:TextBox Width="300"
                        Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged, 
                                       ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                </StackPanel>
                <TextBlock Foreground="Red" FontSize="12" 
                           Text="{Binding (Validation.Errors)[0].ErrorContent, 
                                  RelativeSource={RelativeSource Mode=PreviousData}}"/>
            </StackPanel>

            <!-- Username -->
            <StackPanel Margin="0 0 0 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="نام کاربری:" Width="100" VerticalAlignment="Center"/>
                    <ui:TextBox Width="300"
                        Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, 
                                       ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                </StackPanel>
                <TextBlock Foreground="Red" FontSize="12" 
                           Text="{Binding (Validation.Errors)[0].ErrorContent, 
                                  RelativeSource={RelativeSource Mode=PreviousData}}"/>
            </StackPanel>

            <!-- Password -->
            <StackPanel Margin="0 0 0 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="رمز عبور:" Width="100" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="PasswordBox" Width="300"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                </StackPanel>
                <TextBlock Foreground="Red" FontSize="12"
                           Text="{Binding PasswordError, Mode=OneWay}"/>
            </StackPanel>

            <!-- Role -->
            <StackPanel Margin="0 0 0 10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="نقش:" Width="100" VerticalAlignment="Center"/>
                    <ComboBox Width="300"
                        ItemsSource="{Binding Roles}"
                        DisplayMemberPath="FaName"
                        SelectedValuePath="Name"
                        SelectedValue="{Binding Role, Mode=TwoWay, 
                                                UpdateSourceTrigger=PropertyChanged,
                                                ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                </StackPanel>
                <TextBlock Foreground="Red" FontSize="12" 
                           Text="{Binding (Validation.Errors)[0].ErrorContent, 
                                  RelativeSource={RelativeSource Mode=PreviousData}}"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="70,20,0,0" Grid.ColumnSpan="2">
            <ui:Button Content="ذخیره" Width="100" Margin="5 0" Click="SaveButton_Click"/>
            <ui:Button Content="انصراف" Width="100" Margin="5 0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
