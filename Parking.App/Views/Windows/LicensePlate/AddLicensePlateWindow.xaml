<ui:FluentWindow x:Class="Parking.App.Views.Windows.LicensePlate.AddLicensePlateWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             Title="افزودن پلاک به گروه"
             Width="600"
             Height="400"
             WindowStartupLocation="CenterOwner"
             FontFamily="{StaticResource IranYekanFont}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500" >

            <!-- Group selection -->
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="10 5">
                <TextBlock Text="انتخاب گروه:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="GroupComboBox"
                          Width="250"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Margin="5 0"/>
            </StackPanel>

            <StackPanel Margin="10" FlowDirection="RightToLeft">
                <Label Content="پلاک را وارد کنید" HorizontalAlignment="Center" FontWeight="Bold"/>
                <Border Background="#20CECECE" Padding="5" Margin="5" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Grid x:Name="IRPlateBox" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="leftNumbersNumberTextBox" FontSize="20" PlaceholderText="_ _" Grid.Column="0" MaxLength="2" MinWidth="70" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <ComboBox x:Name="plateCharsCombo" IsEditable="True" FontSize="20" SelectedIndex="0" Grid.Column="1"/>
                            <ui:TextBox x:Name="rightNumbersNumberTextBox" FontSize="20" PlaceholderText="_ _ _" Grid.Column="2" MaxLength="3" MinWidth="100" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <ui:TextBox x:Name="irNumberTextBox" MinWidth="70" FontSize="20" PlaceholderText="_ _" Grid.Column="3" MaxLength="2" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"  Margin="10">
                <ui:Button Content="ثبت" Appearance="Primary" Width="120" Click="SaveButton_Click"/>
                <ui:Button Content="انصراف" Appearance="Secondary" Width="120" Click="CancelButton_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</ui:FluentWindow>
