<ui:FluentWindow x:Class="Parking.App.Views.Windows.ConfigDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Parking.App"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:components="clr-namespace:Parking.App.Views.Components" 
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource IranYekanFont}"  
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FlowDirection="RightToLeft"
        Title="تنظیم پایگاه داده" 
        d:DesignWidth="850"
        Width="850"
        Height="800">
    <StackPanel>
        <ui:TitleBar
        x:Name="TitleBar" DockPanel.Dock="Top"
        Title="تنظیم پایگاه داده"
        Grid.Row="0"
        CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/database.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel HorizontalAlignment="Center">
            <ui:Image Source="pack://application:,,,/Assets/wpfui-icon-256.png" Width="100"/>
            <ui:Image Source="pack://application:,,,/Assets/Madaar-Logo.png" Width="100"/>
            <Separator Margin="0 5"/>
            <TextBlock Text="تنظیم پایگاه داده"  FontSize="20" FontWeight="Bold"/>
        </StackPanel>
        <Border CornerRadius="10" Background="#20B9B9B9" BorderThickness="1" Margin="20 10">
            <StackPanel>
                <StackPanel Margin="10">
                    <TextBlock Text="برای شروع به کار با برنامه، لازم است اطلاعات مربوط به پایگاه داده خود را در این صفحه وارد کنید. بدون انجام این تنظیمات، برنامه قادر به اجرا نخواهد بود." FontSize="13" TextWrapping="Wrap"  />

                </StackPanel>
                <TextBlock Text="لطفاً اطلاعات زیر را به دقت تکمیل کنید:" Margin="10 5 0 0" TextWrapping="Wrap" FontWeight="Bold" FontSize="13" />

                <StackPanel Margin="40 10">

                    <TextBlock Text="هاست پایگاه داده (Database Host):" TextWrapping="Wrap" FontWeight="Bold"  FontSize="13"/>
                    <TextBlock  TextWrapping="Wrap"  FontSize="13" >
                        <Run Text="آدرس سروری که پایگاه داده روی آن قرار دارد را وارد کنید. این می‌تواند یک IP (مانند "/>
                        <Run Text="192.168.1.1" FontWeight="Bold"/>
                        <Run Text=")"/>
                        <Run Text="یا نام دامنه (مانند"/>
                        <Run Text="dbserver.example.com" FontWeight="Bold"/>
                        <Run Text=")"/>
                        <Run Text="باشد."/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="40 10">
                    <TextBlock Text="نام پایگاه داده (Database Name):" TextWrapping="Wrap" FontWeight="Bold"  FontSize="13"/>
                    <TextBlock Text="نام پایگاه داده‌ای که قصد اتصال به آن را دارید. این نام باید دقیقاً با نام پایگاه داده‌ای که ایجاد کرده‌اید، مطابقت داشته باشد." FontSize="13" TextWrapping="Wrap"  />
                </StackPanel>
                <StackPanel Margin="40 10">
                    <TextBlock Text="نام کاربری پایگاه داده (Username):" TextWrapping="Wrap" FontWeight="Bold"  FontSize="13"/>
                    <TextBlock Text="نام کاربری که برای اتصال به پایگاه داده استفاده می‌شود. این نام کاربری باید دسترسی لازم به پایگاه داده مشخص‌شده را داشته باشد." FontSize="13" TextWrapping="Wrap"  />
                </StackPanel>
                <StackPanel Margin="40 10">
                    <TextBlock Text="رمز عبور پایگاه داده (Password):" TextWrapping="Wrap" FontWeight="Bold"  FontSize="13"/>
                    <TextBlock Text="رمز عبور مربوط به نام کاربری پایگاه داده را وارد کنید. لطفاً این اطلاعات را به دقت وارد کنید و مطمئن شوید که صحیح است." FontSize="13" TextWrapping="Wrap"  />
                </StackPanel>
            </StackPanel>

        </Border>
        <Border Visibility="Collapsed" x:Name="msgBox" CornerRadius="10" Background="#206ce09a" BorderThickness="1" Margin="20 10" Padding="10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="connectionTestMessage"  />
            </StackPanel>
        </Border>
        <WrapPanel Margin="10" HorizontalAlignment="Center">
            <StackPanel Width="300" Margin="5">
                <TextBlock Text="هاست پایگاه داده"     />
                <ui:TextBox x:Name="dbHostAddress" FlowDirection="LeftToRight"/>
            </StackPanel>
            <StackPanel Width="300" Margin="5">
                <TextBlock Text="نام پایگاه داده" />
                <ui:TextBox x:Name="dbName" FlowDirection="LeftToRight"/>
            </StackPanel>
            <StackPanel Width="300" Margin="5">
                <TextBlock Text="نام کاربری پایگاه داده" />
                <ui:TextBox x:Name="dbUsername" FlowDirection="LeftToRight"/>
            </StackPanel>
            <StackPanel Width="300" Margin="5">
                <TextBlock Text="رمز عبور پایگاه داده" />
                <ui:PasswordBox x:Name="dbPassword" TextChanged="TextBox_TextChanged" FlowDirection="LeftToRight"/>
            </StackPanel>

            <DockPanel >
                <StackPanel  DockPanel.Dock="Right"   >
                    <ui:Button Appearance="Primary" 
                                           x:Name="SaveDbConfigBtn"
                               Click="SaveDbConfigBtn_Click"
                                           IsEnabled="False" 
                                           Icon="{ui:SymbolIcon Symbol=Save28}" 
                                           Content="ذخیره اطلاعات" 
                                           Height="40" 
                                           Margin="10 0"
                                           HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel  DockPanel.Dock="Left" >
                    <ui:Button Appearance="Transparent"
                               x:Name="TestDbConnectionBtn"

                           Icon="{ui:SymbolIcon Symbol=BookDatabase24}" 
                           Content="تست اتصال" 
                           Height="40"
                           Margin="10 0"
                           Click="TestDbConnectionBtn_Click"
                               
                           />
                </StackPanel>
            </DockPanel>
        </WrapPanel>

    </StackPanel>
</ui:FluentWindow>
