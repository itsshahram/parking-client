<UserControl x:Class="Parking.App.Views.Components.ExitedStatusBorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Parking.App.Views.Components"
             mc:Ignorable="d" Foreground="{DynamicResource TextFillColorPrimaryBrush}" d:DesignWidth="800">
    <Border x:Name="MainBorder"
            Background="Red"
            Margin="10 0 10 5"
            Padding="5"
            CornerRadius="7"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center">
        <TextBlock x:Name="StatusText"
                   Text="خارج نشده است"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontWeight="Bold" />
    </Border>

</UserControl>
