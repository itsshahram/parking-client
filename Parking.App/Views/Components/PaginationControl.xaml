<UserControl x:Class="Parking.App.Views.Components.PaginationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Parking.App.Views.Components"
             FontFamily="{StaticResource IranYekanFont}" 
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d" >
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <ui:Button  Icon="{ui:SymbolIcon Symbol=ArrowPrevious24}" Click="FirstPage_Click" Margin="4,0"/>
        <ui:Button   Icon="{ui:SymbolIcon Symbol=ChevronLeft24}" Click="PreviousPage_Click" Margin="4,0"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="{Binding CurrentPage, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="4,0"/>
            <TextBlock Text="/" Margin="4,0"/>
            <TextBlock Text="{Binding TotalPages, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="4,0"/>
        </StackPanel>

        <ui:Button Icon="{ui:SymbolIcon Symbol=ChevronRight24}" Click="NextPage_Click" Margin="4,0"/>
        <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowNext24}" Click="LastPage_Click" Margin="4,0"/>
    </StackPanel>
</UserControl>
