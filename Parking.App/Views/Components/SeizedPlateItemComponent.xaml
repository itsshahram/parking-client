<UserControl x:Class="Parking.App.Views.Components.SeizedPlateItemComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Parking.App.Views.Components"
             mc:Ignorable="d" 
             FontFamily="{StaticResource IranYekanFont}"
             d:DesignWidth="450"
Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid>
        <Border  Background="#33828FA8"   CornerRadius="7">
            <StackPanel Margin="15">
                <Border BorderBrush="#999999" BorderThickness="1" CornerRadius="7" Margin="5 10 5 10" HorizontalAlignment="Center" Padding="20 5 20 5">
                    <TextBlock Text="{Binding FaLicensePlate}" FontSize="20" FontStyle="Normal" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>
                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="10">
                        <TextBlock  >
                            <Run Text="تاریخ:" />
                            <Run Text="{Binding CreateDateShamsi}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="10">
                        <TextBlock   Text="دلیل:" TextWrapping="Wrap">
                            <Run Text="{Binding SeizedReason}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
