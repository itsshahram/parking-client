<UserControl x:Class="Parking.App.Views.Components.VehicleSegmentPriceCom"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Parking.App"
             mc:Ignorable="d" 
             FontFamily="{StaticResource IranYekanFont}">
    <UserControl.Resources>
        <local:TimeFormatConverter x:Key="TimeFormatConverter" />
    </UserControl.Resources>

    <Border  CornerRadius="7" Background="#33828FA8" FlowDirection="RightToLeft" 
            Padding="10">
        <StackPanel>
            <TextBlock Text="{Binding NameFa}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" />
            <TextBlock  FontSize="14"> 
                <Run  Text="مبلغ ثابت"/>
                <Run  Text="{Binding ParkingEntranceFixedFee, StringFormat=N0}"/>
                <Run  Text="ريال"/>
            </TextBlock>
            <TextBlock  FontSize="14"> 
                <Run  Text="مبلغ روزانه"/>
                <Run  Text="{Binding DailyRate, StringFormat=N0}"/>
                <Run  Text="ريال"/>
            </TextBlock>
            <TextBlock Text="{Binding FreeEntranceMinutes, StringFormat='دقیقه رایگان ورودی: {0} دقیقه'}" FontSize="14" Margin="0,0,0,10"/>

            <ItemsControl ItemsSource="{Binding VehicleSegmentPrices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border  Background="#33828FA8" BorderThickness="1" CornerRadius="5" Padding="5" Margin="5">
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="از ساعت" />
                                    <Run Text="{Binding TimeFrom, Converter={StaticResource TimeFormatConverter}}" />
                                    <Run Text="تا ساعت" />
                                    <Run Text="{Binding TimeTo, Converter={StaticResource TimeFormatConverter}}" />
                                </TextBlock>

                                <TextBlock Margin="0,0,0,5">
                                    <Run Text="مبلغ ساعتی:"   />
                                    <Run Text="{Binding HourlyRate, StringFormat=N0}"   />
                                    <Run  Text="ريال"/>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding VehicleSegmentVariablePrices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock  Margin="0,0,5,0">
                                                    <Run  Text="{Binding Minutes}"/>
                                                    <Run  Text="دقیقه"/>
                                                </TextBlock>
                                                <TextBlock  Margin="0,0,5,0">
                                                    <Run  Text="شماره"/>
                                                    <Run  Text="{Binding Number}"/>
                                                    <Run  Text=":"/>
                                                </TextBlock>

                                                <TextBlock >
                                                    
                                                    <Run  Text="{Binding Price, StringFormat=N0}"/>
                                                    <Run  Text="ريال"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>

</UserControl>
