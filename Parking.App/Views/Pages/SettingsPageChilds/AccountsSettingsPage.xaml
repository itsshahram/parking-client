<Page x:Class="Parking.App.Views.Pages.SettingsPageChilds.AccountsSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Parking.App.Views.Pages.SettingsPageChilds"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      FontFamily="{StaticResource IranYekanFont}" 
      d:DesignHeight="450" d:DesignWidth="800"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="AccountsSettingsPage">

    <StackPanel FlowDirection="RightToLeft" Margin="10">
        <TextBlock Text="تنظیمات اکانت" Grid.Row="0"  FontWeight="Bold" FontSize="15"    Margin="10"  />
        <Border Background="#2071CCB3" Margin="5" Padding="10" CornerRadius="7">
            <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                <DockPanel>
                    <ui:Button x:Name="LogOut" Click="LogOut_Click" DockPanel.Dock="Right" Icon="{ui:SymbolIcon Symbol=ArrowExit20}"/>
                    <StackPanel DockPanel.Dock="Left" Margin="5">
                        <TextBlock  Text="شما قبلا وارد شده اید" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="شما با نام کاربری"   />
                            <Run x:Name="UserNameText" Text="---"/>
                            <Run Text="وارد شده اید" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>
        <!--<Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
            <WrapPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="نام کاربری" />
                    <ui:TextBox Icon="{ui:SymbolIcon Symbol=Person24}" MinWidth="250"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="رمز عبور" />
                    <ui:TextBox Icon="{ui:SymbolIcon Symbol=Password24}" MinWidth="250"/>
                </StackPanel>
                <StackPanel MinWidth="250" Margin="5">
                    <TextBlock Text=" " />
                    <ui:Button Appearance="Primary" Content="ورود" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </WrapPanel>
        </Border>-->


    </StackPanel>
</Page>
