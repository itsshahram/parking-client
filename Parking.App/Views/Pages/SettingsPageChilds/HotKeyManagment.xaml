<Page x:Class="Parking.App.Views.Pages.SettingsPageChilds.HotKeyManagment"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Parking.App.Converters"
      FontFamily="{StaticResource IranYekanFont}" 
      Title="HotKeyManagment">

    <Page.Resources>
        <!-- Converter to display enum Display(Name) attribute -->
        <local:EnumDisplayNameConverter x:Key="EnumDisplayNameConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" FlowDirection="RightToLeft">

            <ItemsControl ItemsSource="{Binding HotKeyConfigs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
                            <DockPanel>
                                <!-- Shortcut input box -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <ui:TextBox Text="{Binding Shortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                FlowDirection="LeftToRight"
                                                MinWidth="200"
                                                PreviewKeyDown="ShortcutTextBox_PreviewKeyDown"
                                                IsReadOnly="True" />
                                </StackPanel>

                                <!-- Label -->
                                <TextBlock DockPanel.Dock="Left" Margin="5"
                                           Text="{Binding Type, Converter={StaticResource EnumDisplayNameConverter}}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Save Button -->
            <Button Content="ذخیره"
                    Click="SaveHotkeys_Click"
                    HorizontalAlignment="Right"
                    Width="180"/>
        </StackPanel>
    </ScrollViewer>
</Page>
