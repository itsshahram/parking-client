<Page x:Class="Parking.App.Views.Pages.SettingsPageChilds.SyncConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Parking.App.Views.Pages.SettingsPageChilds"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:Properties="clr-namespace:Parking.App"
      mc:Ignorable="d" 
      FontFamily="{StaticResource IranYekanFont}" 
      d:DesignHeight="450" d:DesignWidth="800"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="SyncConfigPage">

    <Grid FlowDirection="RightToLeft">
        <ScrollViewer Grid.Row="1"  VerticalAlignment="Stretch"  VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="5" FontWeight="Bold" Text="تنظیمات همگام سازی داده ها" />

                <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
                    <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" x:Name="SyncUsers" Click="SyncUsers_Click" Content="همگام سازی" />
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="5"  Text="همگامسازی دستی لیست کاربران" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
                    <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" x:Name="SyncPriceList" Click="SyncPriceList_Click" Content="همگام سازی" />
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="5"  Text="همگامسازی دستی لیست تعرفه ها" />
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
