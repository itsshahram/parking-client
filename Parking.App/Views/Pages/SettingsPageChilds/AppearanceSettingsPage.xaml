<Page x:Class="Parking.App.Views.Pages.SettingsPageChilds.AppearanceSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Parking.App.Views.Pages.SettingsPageChilds"
      xmlns:Properties="clr-namespace:Parking.App"
      xmlns:helpers="clr-namespace:Parking.App.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      FontFamily="{StaticResource IranYekanFont}" 
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      d:DesignHeight="450" d:DesignWidth="800"
   

      Title="AppearanceSettingsPage">
    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <DataTemplate x:Key="ComboBoxItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Id}" Margin="5" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding NameFa}" Margin="5" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid FlowDirection="RightToLeft" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0 5">
            <!--<ui:Button Content="ذخیره تنظیمات" DockPanel.Dock="Right" Appearance="Primary" Click="Change_Click" Icon="{ui:SymbolIcon Symbol=Save24}"/>-->
            <TextBlock Text="تنظیمات نمایشی" DockPanel.Dock="Left" FontWeight="Bold" FontSize="15"    Margin="10 5"  />
            
        </DockPanel>
        
        <ScrollViewer Grid.Row="1"  VerticalAlignment="Stretch"  VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
                    <StackPanel >

                        <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Left">

                            <TextBlock Margin="5" FontWeight="Bold" Text="تنظیمات رنگ" />
                            <RadioButton x:Name="lightRadio"
        Margin="0,12,0,0"
        Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
        CommandParameter="theme_light"
        Content="تم روشن"
        GroupName="themeSelect"
        IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" 
                />
                            <RadioButton
                                x:Name="darkRadio"
        Margin="0,8,0,0"
        Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
        CommandParameter="theme_dark"
        Content="تم تاریک"
        GroupName="themeSelect"
        IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />
                            <RadioButton
                                x:Name="systemRadio"
        Margin="0,8,0,0"
        Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
        CommandParameter="theme_system"
        Content="سیستم"
        GroupName="themeSelect"
       />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Margin="5" FontWeight="Bold" Text="تنظیمات نمایش داده ها" />
                
                <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
                    <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" Click="Change_Click" IsChecked="{Binding Source={x:Static Properties:Settings.Default}, Path=Appearance_ShowLatestExited, Mode=TwoWay}" FlowDirection="LeftToRight" OffContent="غیر فعال" OnContent="فعال" />
                            <TextBlock DockPanel.Dock="Left" Margin="5"  Text="نمایش آخرین خروج ها در صفحه اصلی" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
                    <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" Click="Change_Click"  IsChecked="{Binding Source={x:Static Properties:Settings.Default}, Path=Appearance_ShowLatestEntry, Mode=TwoWay}" FlowDirection="LeftToRight" OffContent="غیر فعال" OnContent="فعال" />
                            <TextBlock DockPanel.Dock="Left" Margin="5"  Text="نمایش آخرین ورود ها در صفحه اصلی" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
                    <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" Click="Change_Click"  IsChecked="{Binding Source={x:Static Properties:Settings.Default}, Path=Appearance_ShowBarcodeSearchBox, Mode=TwoWay}" FlowDirection="LeftToRight" OffContent="غیر فعال" OnContent="فعال" />
                            <TextBlock DockPanel.Dock="Left" Margin="5"  Text="نمایش امکان نمایش قبض با بارکد" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
                    <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" Click="Change_Click"  IsChecked="{Binding Source={x:Static Properties:Settings.Default}, Path=Appearance_ShowLatestTicket, Mode=TwoWay}" FlowDirection="LeftToRight" OffContent="غیر فعال" OnContent="فعال" />
                            <TextBlock DockPanel.Dock="Left" Margin="5"  Text="نمایش آخرین ورود ثبت شده" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
                    <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" FlowDirection="LeftToRight"
                                      x:Name="MainPageDataUpdateInterval"
                                      MaxWidth="70"
                                      SelectionChanged="MainPageDataUpdateInterval_SelectionChanged"
                                      SelectedValue="{Binding Source={x:Static Properties:Settings.Default}, Path=Appearance_UpdateListInterval, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Tag="5">
                                    <TextBlock Text="5" />
                                </ComboBoxItem>
                                <ComboBoxItem Tag="15">
                                    <TextBlock Text="15" />
                                </ComboBoxItem>
                                <ComboBoxItem Tag="20">
                                    <TextBlock Text="20" />
                                </ComboBoxItem>
                                <ComboBoxItem Tag="25">
                                    <TextBlock Text="25" />
                                </ComboBoxItem>
                            </ComboBox>

                            <TextBlock DockPanel.Dock="Left" Margin="5"  Text="زمان بروزرسانی داده ها در صفحه اصلی" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Background="#20B9B9B9" Margin="5" Padding="10" CornerRadius="7">
                    <StackPanel FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right"
                                      x:Name="InvoiceShowTime" 
                                      SelectionChanged="InvoiceShowTime_SelectionChanged"
                                      FlowDirection="LeftToRight"
                                        SelectedValue="{Binding Source={x:Static Properties:Settings.Default}, Path=Appearance_InvoiceShowTime, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      Width="130">
                                <ComboBoxItem Tag="2">
                                    <TextBlock Text="2" />
                                </ComboBoxItem>
                                <ComboBoxItem  Tag="5">
                                    <TextBlock Text="5"/>
                                </ComboBoxItem>
                                <ComboBoxItem  Tag="10">
                                    <TextBlock Text="10"/>
                                </ComboBoxItem>
                                <ComboBoxItem  Tag="0">
                                    <TextBlock Text="خروج دستی"/>
                                </ComboBoxItem>
                            </ComboBox>
                            <TextBlock DockPanel.Dock="Left" Margin="5"  Text="زمان خارج شدن از رسید دیجیتال" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
