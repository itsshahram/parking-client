<Page x:Class="Parking.App.Views.Pages.LicensePlate.LicensePlatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:components="clr-namespace:Parking.App.Views.Components"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      FontFamily="{StaticResource IranYekanFont}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="LicensePlateGroupPage">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" Margin="10 5">
                <TextBlock Text="گروه پلاک‌ها" FontWeight="Bold" FontSize="20" Margin="10 0"/>
                <ui:Button Content="افزودن پلاک به گروه" Click="AddLicensePlate_Click" Margin="10 0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Margin="10 5">
                <TextBlock Text="فیلتر بر اساس گروه:" VerticalAlignment="Center" Margin="5"/>

                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="GroupFilterComboBox"
                      Width="250"
                      IsEditable="True"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      StaysOpenOnEdit="True"
                      IsTextSearchEnabled="False"
                      SelectionChanged="GroupFilter_SelectionChanged"
                      Margin="5 0" />


                    <ui:Button 
               Click="SearchGroupButton_Click"
               Icon="{ui:SymbolIcon Symbol=Search20}"
               Appearance="Primary"
               VerticalAlignment="Stretch"
               Margin="10 0"
               Padding="40 0"/>
                </StackPanel>

                <ui:Button Content="پاک کردن فیلتر"
               Click="ClearGroupFilter_Click"
               Appearance="Secondary"
               Margin="5 0"/>
            </StackPanel>

            <StackPanel Margin="10">
                <Label Content="پلاک را وارد کنید" Margin="10 5 0 0" HorizontalAlignment="Center"/>
                <Border Background="#20CECECE" FlowDirection="RightToLeft" Padding="5" Margin="5" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Grid x:Name="IRPlateBox" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="leftNumbersNumberTextBox" FontSize="20" PlaceholderText="_ _" Grid.Column="0" MaxLength="2" MinWidth="70" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <ComboBox x:Name="plateCharsCombo" IsEditable="True" FontSize="20" SelectedIndex="0" Grid.Column="1"/>
                            <ui:TextBox x:Name="rightNumbersNumberTextBox" FontSize="20" PlaceholderText="_ _ _" Grid.Column="2" MaxLength="3" MinWidth="100" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <ui:TextBox x:Name="irNumberTextBox" MinWidth="70" FontSize="20" PlaceholderText="_ _" Grid.Column="3" MaxLength="2" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </Grid>
                        <ui:Button x:Name="btnSearch" Click="btnSearch_Click" Content="جستجو" Appearance="Primary" VerticalAlignment="Stretch" Margin="10 0" Padding="40 0"/>
                        <ui:Button x:Name="ClearBtn" Click="ClearBtn_Click" Appearance="Secondary" Padding="5" Margin="10 0 10 0" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" FontSize="24"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <DockPanel HorizontalAlignment="Stretch" Margin="20 5" FlowDirection="RightToLeft">
                <components:PaginationControl 
                    FlowDirection="LeftToRight"
                    CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                    TotalPages="{Binding TotalPages}"
                    PageChanged="Pagination_PageChanged"/>
            </DockPanel>
        </StackPanel>

        <ui:DataGrid x:Name="PlateDataGrid"
                     Margin="0 10"
                     FlowDirection="RightToLeft"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     ItemsSource="{Binding Items, Mode=OneWay}"
                     CanUserAddRows="False">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="نام گروه" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" MinWidth="150" MaxWidth="250">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="پلاک" Binding="{Binding FaLicensePlate}"/>
                <DataGridTextColumn Header="تخفیف" Binding="{Binding DiscountPercent}"/>
                <DataGridTextColumn Header="تاریخ شروع" Binding="{Binding StartDateString}"/>
                <DataGridTextColumn Header="تاریخ پایان" Binding="{Binding EndDateString}"/>
                <DataGridTemplateColumn Header="عملیات">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="حذف"
                                       Appearance="Danger"
                                       Click="DeleteLicensePlate_Click"
                                       Margin="5 0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </DockPanel>
</Page>
