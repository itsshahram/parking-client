<Page x:Class="Parking.App.Views.Pages.LicensePlate.LicensePlateTabsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:pages="clr-namespace:Parking.App.Views.Pages.LicensePlate"
      xmlns:components="clr-namespace:Parking.App.Views.Components"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      FontFamily="{StaticResource IranYekanFont}"
      Background="{DynamicResource ControlFillColorDefaultBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="LicensePlateTabsPage">

    <Page.Resources>
        <!-- ✅ Theme-aware TabItem style -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    Padding="10 5"
                                    CornerRadius="4">
                                <ContentPresenter x:Name="Content"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>

                            <Border x:Name="BottomBar"
                                    Height="3"
                                    Background="Transparent"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="2"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Selected tab -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BottomBar"
                                        Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>

                            <!-- Hovered tab -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
                            </Trigger>

                            <!-- Disabled tab -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- ✅ Theme-aware container -->
    <DockPanel LastChildFill="True"
               Background="{DynamicResource ControlAltFillColorDefaultBrush}">
        <components:ParkingInfo DockPanel.Dock="Top" Margin="0,0,0,10"/>

        <TabControl FlowDirection="RightToLeft"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="5"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <TabItem Header="گروه‌ها">
                <Frame x:Name="LicensePlateGroupFrame"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent"/>
            </TabItem>

            <TabItem Header="گروه پلاک‌ها">
                <Frame x:Name="LicensePlateFrame"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Page>
