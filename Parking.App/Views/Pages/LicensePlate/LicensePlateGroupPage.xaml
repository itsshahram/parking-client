<Page x:Class="Parking.App.Views.Pages.LicensePlate.LicensePlateGroupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Parking.App.Views.Pages"
      xmlns:components="clr-namespace:Parking.App.Views.Components"
      xmlns:models="clr-namespace:Parking.App.Models.Tickets"
      xmlns:helpers="clr-namespace:Parking.App.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      FontFamily="{StaticResource IranYekanFont}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="LicensePlateGroupPage">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                <TextBlock Text="گروه پلاک ها" FlowDirection="RightToLeft" FontWeight="Bold" FontSize="20" Margin="10 10 10 0"/>
                <ui:Button Content="افزودن گروه پلاک" Click="AddLicensePlate_Click" Margin="10 0"/>
            </StackPanel>
            <StackPanel  DockPanel.Dock="Top"  Margin="10">
                <Label Content="پلاک را وارد کنید" Margin="10 5 0 0"   HorizontalAlignment="Center" />
                <Border Background="#20CECECE" FlowDirection="RightToLeft" Padding="5" Margin="5" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Grid x:Name="IRPlateBox"  FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <ui:TextBox Grid.Row="0" x:Name="leftNumbersNumberTextBox"   FontSize="20" PlaceholderText="_ _" Grid.Column="0" MaxLength="2" MinWidth="70" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <ComboBox Grid.Row="0" x:Name="plateCharsCombo"  IsEditable="True" FontSize="20" SelectedIndex="0"
                              Grid.Column="1">
                            </ComboBox>
                            <ui:TextBox Grid.Row="0"  x:Name="rightNumbersNumberTextBox"  FontSize="20" PlaceholderText="_ _ _" Grid.Column="2" MaxLength="3"  MinWidth="100" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <ui:TextBox Grid.Row="0"  x:Name="irNumberTextBox" MinWidth="70"   FontSize="20"   PlaceholderText="_ _" Grid.Column="3"  MaxLength="2"  FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>
                        <ui:Button x:Name="btnSearch" Click="btnSearch_Click" Content="جستجو" Appearance="Primary" VerticalAlignment="Stretch" Margin="10 0" Padding="40 0"/>
                        <ui:Button x:Name="ClearBtn" Click="ClearBtn_Click"  HorizontalAlignment="Center" IsDefault="True" Appearance="Secondary" Padding="5 5 5 5" Margin="10 0 10 0"  Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" FontSize="24"/>

                    </StackPanel>
                </Border>
            </StackPanel>

            <DockPanel  DockPanel.Dock="Top"  HorizontalAlignment="Stretch" Margin="20 5" FlowDirection="RightToLeft">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" >
                    <TextBlock  Text="{Binding TotalCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Name="resultCount"  FontWeight="Bold" Margin="5 0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="عدد" />
                </StackPanel>
                <TextBlock Text="نتایج" FontWeight="Bold" DockPanel.Dock="Left"/>
            </DockPanel>
            <DockPanel  DockPanel.Dock="Top"  HorizontalAlignment="Stretch" Margin="20 5" FlowDirection="RightToLeft">
                <components:PaginationControl 
                FlowDirection="LeftToRight"
                        CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                        TotalPages="{Binding TotalPages}"
                        PageChanged="Pagination_PageChanged"
                                     DockPanel.Dock="Left"/>
            </DockPanel>
        </StackPanel>

        <ui:DataGrid x:Name="PlateDataGrid"  
                     Margin="0 10" 
                     FlowDirection="RightToLeft" 
                     AutoGenerateColumns="False" IsReadOnly="True" 
                     ItemsSource="{Binding Items, Mode=OneWay}"
                             CanUserAddRows="False">
            <ui:DataGrid.Columns>
                <DataGridTextColumn Header="نام گروه" Binding="{Binding Name, Mode=OneWay}" />
                <DataGridTextColumn Header="توضیحات" MinWidth="150" MaxWidth="250" Binding="{Binding Description, Mode=OneWay}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="پلاک" Binding="{Binding FaLicensePlate, Mode=OneWay}" />
                <DataGridTextColumn Header="تخفیف" Binding="{Binding DiscountPercent, Mode=OneWay}" />
                <DataGridTextColumn Header="تاریخ شروع" Binding="{Binding StartDateString, Mode=OneWay}" />
                <DataGridTextColumn Header="تاریخ پایان" Binding="{Binding EndDateString, Mode=OneWay}" />
                <DataGridCheckBoxColumn  Header="وضعیت" Binding="{Binding IsActive, Mode=OneWay}" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>
    </DockPanel>

</Page>
