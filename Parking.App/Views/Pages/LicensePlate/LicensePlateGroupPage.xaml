<Page x:Class="Parking.App.Views.Pages.LicensePlate.LicensePlateGroupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:components="clr-namespace:Parking.App.Views.Components"
      mc:Ignorable="d"
      FontFamily="{StaticResource IranYekanFont}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      FlowDirection="RightToLeft"
      d:DesignWidth="1024"
      d:DesignHeight="768"
      Title="LicensePlateGroupPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" FlowDirection="RightToLeft">
            <DockPanel LastChildFill="False" FlowDirection="RightToLeft">
                <TextBlock Text="مدیریت گروه‌های پلاک"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"/>
                <ui:Button Content="افزودن گروه"
                           Appearance="Primary"
                           Padding="16 6"
                           Margin="10 0 0 0"
                           Click="AddLicensePlate_Click"
                           DockPanel.Dock="Left"/>
            </DockPanel>

            <Border CornerRadius="10" Padding="16" Background="{DynamicResource ControlFillColorSecondaryBrush}" Margin="0 10 0 0">
                <StackPanel>
                    <TextBlock Text="فیلترها" FontWeight="Bold" Margin="0 0 0 8"/>
                    <WrapPanel FlowDirection="RightToLeft" ItemWidth="260" ItemHeight="Auto" MinWidth="0">
                        <StackPanel Margin="8 4" Width="240">
                            <TextBlock Text="نام گروه"/>
                            <ui:TextBox Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="نام گروه"/>
                        </StackPanel>
                        <StackPanel Margin="8 4" Width="160">
                            <TextBlock Text="درصد تخفیف"/>
                            <ui:TextBox Text="{Binding FilterDiscount, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="0"
                                        PreviewTextInput="NumberOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Margin="8 4" Width="360">
                            <TextBlock Text="تاریخ شروع"/>
                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                <ui:TextBox Width="60" MaxLength="4" Margin="0 0 4 0" PlaceholderText="1403" Text="{Binding StartYear, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                <TextBlock Text="/" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                <ui:TextBox Width="40" MaxLength="2" Margin="0 0 4 0" PlaceholderText="01" Text="{Binding StartMonth, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                <TextBlock Text="/" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                <ui:TextBox Width="40" MaxLength="2" Margin="0 0 4 0" PlaceholderText="01" Text="{Binding StartDay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                <TextBlock Text="|" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                <ui:TextBox Width="40" MaxLength="2" Margin="0 0 4 0" PlaceholderText="00" Text="{Binding StartHour, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                <TextBlock Text=":" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                <ui:TextBox Width="40" MaxLength="2" PlaceholderText="00" Text="{Binding StartMinute, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="8 4" Width="360">
                            <TextBlock Text="تاریخ پایان"/>
                            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                                <ui:TextBox Width="60" MaxLength="4" Margin="0 0 4 0" PlaceholderText="1403" Text="{Binding EndYear, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                <TextBlock Text="/" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                <ui:TextBox Width="40" MaxLength="2" Margin="0 0 4 0" PlaceholderText="12" Text="{Binding EndMonth, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                <TextBlock Text="/" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                <ui:TextBox Width="40" MaxLength="2" Margin="0 0 4 0" PlaceholderText="29" Text="{Binding EndDay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                <TextBlock Text="|" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                <ui:TextBox Width="40" MaxLength="2" Margin="0 0 4 0" PlaceholderText="23" Text="{Binding EndHour, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                                <TextBlock Text=":" Margin="0 0 4 0" VerticalAlignment="Center"/>
                                <ui:TextBox Width="40" MaxLength="2" PlaceholderText="59" Text="{Binding EndMinute, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumberOnly_PreviewTextInput"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="8 4" Orientation="Horizontal" Width="240" HorizontalAlignment="Stretch">
                            <ui:Button Content="پاکسازی"
                                       Appearance="Secondary"
                                       Margin="0 0 8 0"
                                       Padding="16 6"
                                       Click="ClearFilter_Click"/>
                            <ui:Button Content="جستجو"
                                       Appearance="Primary"
                                       Padding="16 6"
                                       Click="SearchBtn_Click"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0 0 0 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Margin="6" Padding="16" CornerRadius="10" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="تعداد کل گروه‌ها" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalGroups}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="6" Padding="16" CornerRadius="10" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="گروه‌های فعال" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalActiveGroups}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessFillColorDefaultBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Margin="6" Padding="16" CornerRadius="10" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="گروه‌های غیرفعال" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalInactiveGroups}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DangerFillColorDefaultBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border CornerRadius="10" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Margin="0 0 0 10">
                <StackPanel>
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="12" CornerRadius="10 10 0 0">
                        <TextBlock Text="لیست گروه‌ها" FontWeight="Bold"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding LicensePlateGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="12" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" CornerRadius="8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0 0 0 8">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Top">
                                                <Border Padding="8 2" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Margin="0 0 4 0">
                                                    <TextBlock Text="{Binding DiscountPercent, StringFormat='{}{0}% تخفیف'}" FontWeight="Bold"/>
                                                </Border>
                                                <Border Padding="8 2" CornerRadius="20" BorderThickness="1" Margin="0 0 4 0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
                                                            <Setter Property="Background" Value="#1900FF00"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Background" Value="#19FF0000"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" Margin="4 0" FontWeight="Bold"/>
                                                </Border>
                                                <ui:Button Content="ویرایش" Appearance="Secondary" Padding="12 4" Margin="0 0 4 0" Click="EditLicensePlateGroup_Click"/>
                                                <ui:Button Content="حذف" Appearance="Danger" Padding="12 4" Margin="0 0 4 0" Click="DeleteLicensePlateGroup_Click"/>
                                                <ui:Button Content="افزودن پلاک" Appearance="Primary" Padding="12 4" Click="AddPlateToGroup_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0 8 0 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="تاریخ شروع: " FontWeight="Bold"/>
                                                <TextBlock Text="{Binding StartDateString}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="تاریخ پایان: " FontWeight="Bold"/>
                                                <TextBlock Text="{Binding EndDateString}"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel>
                                            <TextBlock Text="پلاک‌ها" FontWeight="Bold" Margin="0 8 0 4"/>
                                            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="0">
                                                <StackPanel>
                                <Grid Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="پلاک فارسی" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="پلاک انگلیسی" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="عملیات" FontWeight="Bold"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Plates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0 0 0 1">
                                                <Grid Padding="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding PersianPlate}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding EnglishPlate}"/>
                                                    <ui:Button Grid.Column="2"
                                                               Content="حذف"
                                                               Appearance="Danger"
                                                               Padding="10 2"
                                                               Margin="0 0 0 0"
                                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               Click="DeletePlate_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="هیچ پلاکی ثبت نشده است"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontStyle="Italic"
                                           HorizontalAlignment="Center"
                                           Margin="0 8"
                                           Visibility="Collapsed">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Plates.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <DockPanel Margin="0 10" FlowDirection="RightToLeft">
                <components:PaginationControl FlowDirection="LeftToRight"
                                              CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                                              TotalPages="{Binding TotalPages}"
                                              PageChanged="PaginationControl_PageChanged"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
