<Page x:Class="Parking.App.Views.Pages.CardsPageChilds.AddCardHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Parking.App.Views.Pages.CardsPageChilds"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:components="clr-namespace:Parking.App.Views.Components"
      xmlns:Properties="clr-namespace:Parking.App"
      FontFamily="{StaticResource IranYekanFont}" 
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="800"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="AddCardHistoryPage">
    <Page.Resources>
        <Style x:Key="MyDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="50"/>
        </Style>
    </Page.Resources>
    <StackPanel FlowDirection="RightToLeft" Margin="10">
        <TextBlock Text="تاریخچه افزودن کارت" Grid.Row="0"  FontWeight="Bold" FontSize="15"    Margin="10"  />
        <Border CornerRadius="6" Padding="0 5"  Background="#20E9E9E9" Margin="5 5 5 0">
            <StackPanel HorizontalAlignment="Center">
                <DockPanel  FlowDirection="RightToLeft" Margin="10 5">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="فیلتر ها" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel FlowDirection="RightToLeft"  HorizontalAlignment="Stretch">
                    <StackPanel Margin="10 5">
                        <TextBlock Text="نام و نام خانوادگی" />
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                            <ui:TextBox Text="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  PlaceholderText="_ _" x:Name="FullNameTextBox"  MinWidth="200" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="10 5">
                        <TextBlock Text="تاریخ ایجاد از" />
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <ui:TextBox x:Name="StartYearTextBox" MaxLength="4"  TextChanged="StartTimeTextBox_TextChanged" PlaceholderText="1403" Text="1403" Margin="2 0"  />
                            <TextBlock Text="/" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="StartMountTextBox" MaxLength="2" TextChanged="StartTimeTextBox_TextChanged" PlaceholderText="06" Text="06" Margin="2 0"  />
                            <TextBlock Text="/" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="StartDayTextBox" MaxLength="2" TextChanged="StartTimeTextBox_TextChanged" PlaceholderText="29" Text="29" Margin="2 0"  />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="10 5">
                        <TextBlock Text="تاریخ ایجاد تا" />
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <ui:TextBox x:Name="EndYearTextBox" MaxLength="4" TextChanged="EndTimeTextBox_TextChanged" PlaceholderText="1403" Text="1403" Margin="2 0"  />
                            <TextBlock Text="/" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="EndMountTextBox" MaxLength="2" TextChanged="EndTimeTextBox_TextChanged" PlaceholderText="06" Text="06" Margin="2 0"  />
                            <TextBlock Text="/" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="EndDayTextBox" MaxLength="2" TextChanged="EndTimeTextBox_TextChanged" PlaceholderText="29" Text="29" Margin="2 0"  />

                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="10 5">
                        <TextBlock Text="پلاک" />
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <ui:TextBox  MaxLength="2" PlaceholderText="_ _" x:Name="leftNumbersNumberTextBox"  Margin="2 0"  />
                            <ui:TextBox  MaxLength="3" PlaceholderText="ب" x:Name="plateCharacter"  Margin="2 0"  />
                            <ui:TextBox MaxLength="3" PlaceholderText="_ _ _" x:Name="rightNumbersNumberTextBox" Margin="2 0"  />
                            <TextBlock Text="|" VerticalAlignment="Center" Margin="2 0"/>
                            <ui:TextBox  MaxLength="2" PlaceholderText="_ _" x:Name="irNumberTextBox"  Margin="2 0"  />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="10 5">
                        <TextBlock Text="شماره کارت" />
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <ui:TextBox Text="{Binding CardUidTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  PlaceholderText="_ _" x:Name="CardUidTextBox"  MinWidth="200" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0 5" >
                        <TextBlock Text=" " />
                        <ui:Button x:Name="ClearBtn"  Click="ClearBtn_Click" HorizontalAlignment="Center" IsDefault="True" Appearance="Secondary" Padding="5 5 5 5"   Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" FontSize="22" />
                    </StackPanel>
                    <StackPanel Margin="10 5" MinWidth="100">
                        <TextBlock Text=" " />
                        <ui:Button Appearance="Primary" Content="جستجو" 
                                   x:Name="SearchBtn" Click="SearchBtn_Click" Icon="{ui:SymbolIcon Symbol=Search20}" VerticalAlignment="Stretch" FontSize="21" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                </WrapPanel>
            </StackPanel>

        </Border>
        <ProgressBar x:Name="progressBar" Margin="10 0"/>

        
        <DockPanel  DockPanel.Dock="Top"  HorizontalAlignment="Stretch" Margin="20 5" FlowDirection="RightToLeft">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" >
                <TextBlock Text="0" x:Name="resultCount"  FontWeight="Bold" Margin="5 0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="عدد" />
            </StackPanel>
            <TextBlock Text="نتایج" FontWeight="Bold" DockPanel.Dock="Left"/>
        </DockPanel>
        <DockPanel  DockPanel.Dock="Top"  HorizontalAlignment="Stretch" Margin="20 5" FlowDirection="RightToLeft">
            <components:PaginationControl 
                FlowDirection="LeftToRight"
                        CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                        TotalPages="{Binding TotalPages}"
                        PageChanged="Pagination_PageChanged"
                                     DockPanel.Dock="Left"/>
        </DockPanel>

        <ScrollViewer CanContentScroll="True" 
                      IsManipulationEnabled="True"
                      HorizontalScrollBarVisibility="Visible" 
                      VerticalScrollBarVisibility="Auto">

            <DataGrid CellStyle="{StaticResource MyDataGridCell}"  
                      FlowDirection="RightToLeft"  
                      IsReadOnly="True" 
                      AutoGenerateColumns="False"  
                      RowHeight="50"  
                      x:Name="HistoryDataGrid" 
                      ItemsSource="{Binding Items}" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch"
                       >
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding EnLicensePlate}" Header="پلاک">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="Padding" Value="5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding OwnerFullName}" Header="نام و نام خانوادگی">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="Padding" Value="5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding CardUid}" Header="آی دی کارت">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="Padding" Value="5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding CreateDate}" Header="تاریخ ایجاد">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="Padding" Value="5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ActiveDate}" Header="تاریخ شروع">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="Padding" Value="5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding DeactiveDate}" Header="تاریخ پایان">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="Padding" Value="5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding PercentDiscount}" Header="درصد تخفیف">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="Padding" Value="5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <DataGridTextColumn Binding="{Binding Description}" Header="شماره پیگیری پرداخت">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="Padding" Value="5" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
    </StackPanel>
</Page>
